{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "strict": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "outDir": ".medusa/server",
    "rootDir": ".",
    "declaration": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", ".medusa", "tests"]
}
