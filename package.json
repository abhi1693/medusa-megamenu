{
  "name": "@abhi1693/medusa-megamenu",
  "version": "0.0.1",
  "description": "Headless native-catalog mega menus for Medusa v2",
  "license": "MIT",
  "repository": "github:abhi1693/medusa-megamenu",
  "engines": {
    "node": ">=22.22.0"
  },
  "files": [
    ".medusa/server",
    "README.md",
    "LICENSE",
    "scripts/copy-snapshots.mjs",
    "VERIFICATION.md"
  ],
  "exports": {
    ".": {
      "types": "./.medusa/server/src/index.d.ts",
      "default": "./.medusa/server/src/index.js"
    },
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js"
    },
    "./rbac": "./.medusa/server/src/rbac.js",
    "./modules/megamenu": "./.medusa/server/src/modules/megamenu/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "medusa plugin:build && node scripts/copy-snapshots.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "test:integration": "npm run build && npm pack --ignore-scripts && node scripts/test-integration.mjs",
    "test:package": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "@medusajs/framework": "2.22.1",
    "@medusajs/medusa": "2.22.1",
    "@medusajs/admin-sdk": "2.22.1",
    "@medusajs/ui": "^4.2.8",
    "@medusajs/icons": "2.22.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@tanstack/react-query": "^5.64.2"
  },
  "devDependencies": {
    "@medusajs/cli": "2.22.1",
    "@medusajs/framework": "2.22.1",
    "@medusajs/medusa": "2.22.1",
    "@medusajs/admin-sdk": "2.22.1",
    "@medusajs/ui": "4.2.8",
    "@medusajs/icons": "2.22.1",
    "@medusajs/dashboard": "2.22.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@tanstack/react-query": "5.64.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "4.1.12",
    "ts-node": "^10.9.2",
    "@swc/core": "^1.15.0"
  },
  "overrides": {
    "@medusajs/utils@2.22.1": {
      "@graphql-codegen/core": "6.2.2",
      "@graphql-codegen/typescript": "6.1.2"
    }
  },
  "keywords": [
    "medusa",
    "medusa-v2",
    "medusa-plugin",
    "mega-menu",
    "navigation",
    "headless",
    "ecommerce",
    "typescript"
  ]
}
